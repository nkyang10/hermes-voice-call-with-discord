# ── Discord Bot ──
DISCORD_BOT_TOKEN=your_discord_bot_token_here
VOICE_GUILD_ID=your_guild_id_here
VOICE_CHANNEL_NAME=Hermes語音
TRANSCRIPT_CHANNEL_ID=your_text_channel_id_here

# ── ComfyUI (for Qwen3-ASR) ──
COMFYUI_URL=http://your-comfyui-server:8000

# ── Hermes Agent (LLM) ──
# The Hermes AI Agent reads API key from Hermes config (~/.hermes/.env or ~/.hermes/config.yaml).
# Make sure your HERMES_HOME/.env or config.yaml has the provider's API key set up.
# Alternatively, set HERMES_HOME env var to point to your Hermes config directory.

# ── STT / Voice tuning (all defaults are hardcoded) ──
# These env vars are no longer read; tuning values are hardcoded in the
# VADUtteranceSink constructor. Edit those defaults directly if needed.
